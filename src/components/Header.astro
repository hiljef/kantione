---
import Navigation from './Navigation.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header>
	<Navigation />
	<h1><a href="/">{title}</a></h1>
</header>

<script>
	type Tool = {
		name: string;
		description: string;
		inputSchema: { type: 'object'; properties: Record<string, never> };
		execute: () => { content: { type: 'text'; text: string }[] };
	};
	const modelContext = (navigator as Navigator & {
		modelContext?: { registerTool: (tool: Tool) => void };
	}).modelContext;

	modelContext?.registerTool({
		name: 'get_kantione_information',
		description: 'Get links to Kantione concert and visitor information.',
		inputSchema: { type: 'object', properties: {} },
		execute: () => ({
			content: [{
				type: 'text',
				text: 'Kantione is a concert series curated by Eleni Poulou at Haus am Waldsee in Berlin. About and visitor information: https://kanti.one/; concerts: https://kanti.one/concerts/; past concerts: https://kanti.one/archive/; accessibility contact: info@hausamwaldsee.de.'
			}]
		})
	});
</script>

<style>
	h1 a {
		color: inherit;
		font-size: inherit;
		text-decoration: none;
	}
</style>
