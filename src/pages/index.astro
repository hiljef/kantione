---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import '../styles/global.css';

const pageTitle = "Kantione";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	
	<body>
		<div class="div1">
		<Header title={pageTitle} />
		 Concert series curated by <b>Eleni Poulou</b> 
         <br /><br />
         Since 2024 <b>Kantione</b> presents new forms of classical music at <b>Haus am Waldsee</b>.
		 <br /><br />
		 Focusing on new interpretations of early music, the series brings together musicians from different backgrounds to explore the connections between contemporary and historical music. The concerts feature both established and emerging artists, often forming
		 new ensembles, premiering their work in an intimate setting.
         <br /><br />
         Concerts take place upstairs in the studio<b> *</b>, outside in the sculpture park, or in the cafe.
         <br /><br />
         Thanks to the generous support of the friends and patrons of Haus am Waldsee, the series continues in 2026 and 2027
         <br /><br />
         <a href="https://hausamwaldsee.de/freunde-und-foerderer/" target="_blank" rel="noopener noreferrer">hausamwaldsee.de/freunde-und-foerderer/</a>
         <hr>
      	 Tickets (16/12 euros) are available <a href="https://hausamwaldsee.de/tickets/" target="blank">online</a> or at the box office
      	 <br /><br />
         <b>Haus am Waldsee</b><br />
	 	 Argentinische Allee 30<br />
         14163 Berlin-Zehlendorf
         <br /><br />
         Bus<br />
	 	 118  Rathaus Zehlendorf<br />
	 	 622 / X11 Krumme Lanke
	 	 <br /><br />
	 	 Bahn<br />
	 	 U3 Krumme Lanke<br />
	 	 S1 Mexikoplatz
		 <br /><br />
	 	 <a href="https://hausamwaldsee.de/" target="_blank" rel="noopener noreferrer">hausamwaldsee.de</a>
	 	 <br /><br />
	 	 <hr>
		 <p>
         <b>*</b> Please note: access to the studio is not barrier-free and can only be reached via stairs. The 1st floor can also be reached by lift (please inform the ticket office). If you have any questions regarding accessibility, please write to: <a href="mailto:info@hausamwaldsee.de" target="blank">info@hausamwaldsee.de</a>. We will do our best to find a solution for your visit!
		 </p>
		 <hr>
	 		 <Footer />
		 </div>
	</body>
</html>
